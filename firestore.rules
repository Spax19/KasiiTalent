rules_version = '2';

// All reads and writes go through Next.js server code using the Firebase Admin SDK,
// which bypasses these rules. Locking every client path means a leaked web config
// can never expose phone numbers, consents or profiles.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
