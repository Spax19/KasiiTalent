# Copy to .env.local (same folder as package.json) and fill in. Never commit real values.
# Restart `npm run dev` after editing.

# --- Firebase Admin (Project settings > Service accounts > Generate new private key) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes and the literal \n sequences exactly as they appear in the downloaded JSON
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Firebase web app config, for employer login/signup in the browser ---
# Project settings > General > Your apps > add a Web app (</>) > copy from the config snippet.
# These are identifiers, not secrets, but still restrict the API key to your domains in Google Cloud.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Long random string used to HMAC phone numbers. Generate with: openssl rand -hex 32
# Changing it later invalidates every stored phoneHash, so back it up.
PHONE_HASH_PEPPER=

# --- Cloudinary (Dashboard > API keys) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- WhatsApp Cloud API (Meta developer dashboard) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=            # the temporary token expires after 24h; use a System User token for anything lasting
WHATSAPP_APP_SECRET=       # App settings > Basic > App secret
WHATSAPP_VERIFY_TOKEN=     # any long random string you invent; paste the same value in Meta's webhook setup

# --- Site ---
# Public URL of the site (used for the privacy link in bot messages)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: your WhatsApp number in digits (e.g. 27821234567) to show a "Start on WhatsApp" button
NEXT_PUBLIC_WHATSAPP_NUMBER=
